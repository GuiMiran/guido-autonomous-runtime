# Keep credentials OUT of Git; copy to .env with chmod 600.
GUIDO_API_TOKEN=replace-with-a-random-secret-at-least-32-chars
GUIDO_MODEL_TOKEN=replace-with-an-independent-vllm-api-key
GUIDO_MODEL_URL=http://127.0.0.1:8000/v1/chat/completions
GUIDO_MODEL=Qwen/Qwen3-32B
GUIDO_MODEL_PROVIDER=openai-compatible
# For private Ollama instead: GUIDO_MODEL_PROVIDER=ollama
# GUIDO_MODEL_URL=http://guido-model.railway.internal:11434/api/generate
# GUIDO_MODEL=qwen2.5:0.5b
GUIDO_STATE_PATH=./data/tasks.jsonl
GUIDO_AUDIT_PATH=./data/audit.jsonl
HOST=127.0.0.1
PORT=8787
